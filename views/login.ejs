<div class="container"><div class="auth">
  <h1>Sign in</h1>
  <form method="post" action="/login" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
    <label class="f" for="e">Email</label><input id="e" type="email" name="email" required autocomplete="email" autofocus>
    <label class="f" for="p" style="margin-top:14px">Password</label><input id="p" type="password" name="password" required autocomplete="current-password">
    <p class="small" style="margin:8px 0 0"><a class="link" href="/forgot">Forgot password?</a></p>
    <button class="btn block" style="margin-top:18px" type="submit">Sign in</button>
  </form>
  <p class="center">New here? <a class="link" href="/register?next=<%= encodeURIComponent(next) %>">Create an account</a></p>
</div></div>
