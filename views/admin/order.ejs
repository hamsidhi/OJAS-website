<div class="admin-top"><h1>Order <%= o.number %></h1><div class="row"><a class="btn ghost sm" href="/admin/orders">&larr; Orders</a><button class="btn ghost sm" type="button" data-print>Print invoice</button></div></div>
<div class="two">
  <div>
    <div class="panel"><h3>Items</h3>
      <% items.forEach(i => { %><div class="mini"><% if (i.image) { %><img src="<%= i.image %>" alt="" width="52" height="69"><% } %><div class="n"><%= i.name %><div class="muted small"><%= i.color %> / <%= i.size %> &times; <%= i.qty %> &middot; <%= i.code %></div></div><b><%= money(i.price * i.qty) %></b></div><% }) %>
      <hr style="border:0;border-top:1px solid var(--line)">
      <div class="sum-row"><span>Subtotal</span><span><%= money(o.subtotal) %></span></div>
      <% if (o.discount) { %><div class="sum-row"><span>Discount (<%= o.coupon %>)</span><span>-<%= money(o.discount) %></span></div><% } %>
      <div class="sum-row"><span>Shipping</span><span><%= money(o.shipping) %></span></div>
      <% if (o.cod_fee) { %><div class="sum-row"><span>COD fee</span><span><%= money(o.cod_fee) %></span></div><% } %>
      <div class="sum-row total"><span>Total</span><span><%= money(o.total) %></span></div>
    </div>
    <div class="panel"><h3>Customer &amp; delivery</h3>
      <p style="margin:0"><b><%= ship.name %></b><br><%= ship.line1 %><% if (ship.line2) { %>, <%= ship.line2 %><% } %><br><%= ship.city %>, <%= ship.state %> <%= ship.pincode %><br>
      Phone: <a class="link" href="tel:<%= ship.phone %>"><%= ship.phone %></a><br>Email: <a class="link" href="mailto:<%= o.email %>"><%= o.email %></a></p>
      <% if (o.note) { %><p class="small" style="margin:12px 0 0"><b>Customer note:</b> <%= o.note %></p><% } %>
    </div>
  </div>
  <div>
    <form method="post" action="/admin/orders/<%= o.number %>" class="panel no-print"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <h3>Manage</h3>
      <p class="small muted">Placed <%= new Date(o.created_at + 'Z').toLocaleString('en-IN') %><br>Payment: <%= PAY_METHOD[o.payment_method] || o.payment_method %><% if (o.gateway_payment_id) { %><br>Gateway ref: <code><%= o.gateway_payment_id %></code><% } %></p>
      <% if (o.status === 'cancelled') { %><p><span class="status cancelled">Cancelled</span> <span class="status <%= o.payment_status %>"><%= PAY_STATUS[o.payment_status] %></span></p>
      <% } else { %>
      <label class="f" for="status">Order status</label>
      <select id="status" name="status"><% Object.keys(ORDER_STATUS).forEach(k => { %><option value="<%= k %>" <%= o.status === k ? 'selected' : '' %>><%= ORDER_STATUS[k] %></option><% }) %></select>
      <label class="f" for="ps" style="margin-top:12px">Payment status</label>
      <select id="ps" name="payment_status"><% Object.keys(PAY_STATUS).forEach(k => { %><option value="<%= k %>" <%= o.payment_status === k ? 'selected' : '' %>><%= PAY_STATUS[k] %></option><% }) %></select>
      <label class="f" for="car" style="margin-top:12px">Courier</label><input id="car" name="carrier" type="text" value="<%= o.carrier || '' %>" placeholder="e.g. Delhivery, India Post">
      <label class="f" for="trk" style="margin-top:12px">Tracking number</label><input id="trk" name="tracking_no" type="text" value="<%= o.tracking_no || '' %>">
      <label class="check" style="margin-top:12px"><input type="checkbox" name="notify" value="1" checked> Email the customer about this update</label>
      <button class="btn block" style="margin-top:14px" type="submit">Save changes</button>
      <% } %>
    </form>
    <% if (o.status !== 'cancelled') { %>
    <form method="post" action="/admin/orders/<%= o.number %>" class="panel no-print" data-confirm-form="Cancel this order and return the items to stock?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="cancelled">
      <h3>Cancel order</h3>
      <% if (o.payment_status === 'paid') { %><label class="check"><input type="checkbox" name="refunded" value="1"> I have already refunded this payment</label><p class="help">Refunds must be issued from your Razorpay / Stripe dashboard.</p><% } %>
      <button class="btn danger sm" style="margin-top:10px" type="submit">Cancel &amp; restock</button>
    </form><% } %>
  </div>
</div>
