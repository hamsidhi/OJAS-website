# Copy this file to ".env" and fill in your values, then restart the server.

PORT=3100
NODE_ENV=development
# Public address of your site (used in emails and payment redirects). Example: https://www.yourshop.com
BASE_URL=http://localhost:3100
# Long random string. REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Database ----
# Local development: leave empty (uses data/store.db).  Vercel / production: a free Turso database (turso.tech)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# ---- Product photo uploads on Vercel: create a Blob store in Vercel (Storage tab); the token is added automatically ----
BLOB_READ_WRITE_TOKEN=

# First admin account (created automatically the first time the server starts)
ADMIN_EMAIL=admin@ojas.example
ADMIN_PASSWORD=ChangeMe123!

# ---- Razorpay (UPI, cards, netbanking, wallets) https://dashboard.razorpay.com ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Stripe (international cards) https://dashboard.stripe.com ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr

# Demo payment page for testing without keys. Set to false before going live.
DEMO_PAYMENTS=true

# ---- Email (order confirmations, password reset). Without SMTP, emails are written to data/outbox.log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where new-order / contact-form alerts go (defaults to the support email in Admin > Settings)
ADMIN_NOTIFY_EMAIL=
